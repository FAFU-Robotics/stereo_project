# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.venv/
.venv-build/
venv/
env/

# ---- 官方仓库里的演示素材（体积大、与功能无关；需要时用原始 zip 重新解压）----
# 注意：官方 core/ scripts/ demo_data/ 等**代码与测试图像必须保留在仓库里**，
#       只排除这些纯展示用的大文件（约 33 MB 的图片/视频）。
third_party/Fast-FoundationStereo/assets/
third_party/Fast-FoundationStereo/output_docker/

# ---- 本项目自动生成的数据（不入库，避免仓库膨胀）----
output/
weights/**/*.pth
weights/**/*.pt
weights/**/*.onnx
weights/**/*.engine
third_party/**/output/
third_party/**/output_docker/
third_party/**/weights/*.pth

# 探测/测试的中间产物
output/probe/_tmp/
*.log

# 临时目录
_tmp/

# 隔离安装/临时工作目录（例如隔离测试用的 OpenCV 4.x、下载的 wheel）
# 这些目录体积大、可随时重建，不入库
_work/
_tmp_cv4/
plaindir/
cache/
tmpdir/
mytemp/
_work_tmp/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# Open3D 3D 窗口"保存视图设置"时写出的文件（每次运行都可能改名，不入库）
RenderOption_*.json

# Python 打包产物（pip install -e . / 构建 wheel 时生成）
build/
dist/
*.egg-info/

# ---- EXE 交付物（约 5 GB，15761 个文件；其中 torch CUDA 运行库约 4.3 GB）----
# 不进仓库：GitHub 单文件资产上限 2 GB，整仓库也不适合承载。
# 对外发布方式见 docs/发布与分发.md（7-Zip 分卷 + GitHub Releases）。
release/
dist_release/
*.7z.*
*.zip.001

# PyInstaller 的中间产物（build_exe.ps1 会在 packaging/ 下生成）
packaging/build/
packaging/dist/
